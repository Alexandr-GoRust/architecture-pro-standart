        <mxCell id="n73" value="&lt;b&gt;Интернет-банк&lt;/b&gt;&lt;br&gt;ASP.NET MVC 4.5, MS SQL&lt;br&gt;монолит на платформе подрядчика&lt;br&gt;один ЦОД + резервный" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="100" width="250" height="100" as="geometry"/></mxCell>
        <mxCell id="n74" value="&lt;b&gt;Сайт&lt;/b&gt;&lt;br&gt;PHP + React.js" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="260" width="250" height="60" as="geometry"/></mxCell>
        <mxCell id="n75" value="&lt;b&gt;Система кол-центра&lt;/b&gt;&lt;br&gt;React + Java Spring Boot + PostgreSQL&lt;br&gt;микросервисы, платформа подрядчика,&lt;br&gt;развёрнута в банке" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="480" width="250" height="100" as="geometry"/></mxCell>
        <mxCell id="n76" value="&lt;b&gt;Система партнёрского&lt;br&gt;кол-центра&lt;/b&gt;&lt;br&gt;внешняя система;&lt;br&gt;скрипты передают бизнес-представители&lt;br&gt;банка по эл. почте" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="680" width="250" height="100" as="geometry"/></mxCell>
        <mxCell id="n77" value="&lt;b&gt;АБС (ядро)&lt;/b&gt;&lt;br&gt;Delphi + Oracle, логика в PL/SQL&lt;br&gt;учёт счетов, бухгалтерия,&lt;br&gt;заявки, ставки, документы&lt;br&gt;(только вертикальное масштабирование)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="850" y="300" width="260" height="150" as="geometry"/></mxCell>
