@startuml C4_Context_Credit_Online
!include <C4/C4_Context>

title C4 L1. Контекст — заявка на кредит онлайн (сайт и интернет-банк)

Person(newClient, "Потенциальный клиент", "подаёт заявку на сайте; известен только БКИ")
Person(client, "Клиент банка", "подаёт заявку в интернет-банке, видит предодобренные предложения")
Person(branchMgr, "Менеджер отделения", "оформляет и продолжает заявки в АБС")
Person(creditBack, "Менеджер бэк-офиса кредитов", "рассматривает заявки в кредитном конвейере")

System(site, "Сайт банка", "PHP + React: предложение кредита, подача заявки")
System(ib, "Интернет-банк", "каталог кредитов, предодобренные предложения, заявка со СМС-кодом")
System(cla, "Сервис кредитных заявок", "НОВЫЙ: единая точка онлайн-каналов — каталог, заявки, СМС-коды и уведомления")
System(conv, "Кредитный конвейер", "Camunda + Oracle: обработка заявок, решения, предодобренные предложения; горизонтальное масштабирование 24/7")
System(scoring, "Система кредитного скоринга", "Python/Flask + ML; источники: БКИ и данные АБС")
System(bki, "Бюро кредитных историй", "внешняя система, REST API")
System(abs, "АБС", "заявки из отделений, счета, зачисление кредитных средств")
System(smsgw, "СМС-шлюз телеком-оператора", "коды подтверждения и уведомления о статусах")

Rel(newClient, site, "Заявка: телефон, Ф. И. О., опционально паспортные данные")
Rel(client, ib, "Заявка по предодобрению, счёт зачисления, СМС-код")
Rel(site, cla, "REST/TLS: каталог условий, заявка")
Rel(ib, cla, "REST/TLS: каталог, предодобренные предложения, заявки, СМС-коды, статусы")
Rel(cla, conv, "REST API конвейера (новый): передача онлайн-заявок напрямую, минуя суточный обмен")
Rel(cla, smsgw, "СМС-коды и уведомления о смене статуса")
Rel(conv, scoring, "REST: запрос скоринга онлайн (при рассмотрении заявки, повторный — по упрощённой процедуре)")
Rel(scoring, bki, "REST: кредитная история онлайн")
Rel(conv, abs, "Существующий обмен раз в сутки по БД: статусы, номера платежей")
Rel(abs, conv, "Существующий обмен раз в сутки по БД: заявки из отделений")
Rel(abs, conv, "REST: поиск заявки клиента для продолжения в отделении (новое)")
Rel(branchMgr, abs, "Десктоп-клиент АБС: заявки, продолжение онлайн-заявки, выдача")
Rel(creditBack, conv, "Рассмотрение заявок и решение")

SHOW_LEGEND()
@enduml
