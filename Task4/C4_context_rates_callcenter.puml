@startuml C4_Context_Rates_CallCenter
!include <C4/C4_Context>

title C4 L1. Контекст — передача ставок по депозитам в кол-центры

Person(depBack, "Менеджер бэк-офиса (депозиты/кредиты)", "ведёт справочник ставок")
Person(ccOperator, "Оператор кол-центра банка", "консультирует клиентов по ставкам")
Person(pccOperator, "Оператор партнёрского кол-центра", "консультирует клиентов по ставкам")
Person(itAdmin, "Сотрудник IT-отдела", "администрирует SFTP-сервер")

System(abs, "АБС", "справочник ставок (единый источник истины)")
System(dis, "Сервис интеграции депозитов", "кэш ставок, API ставок, экспорт ставок в файл")
System(cc, "Система кол-центра банка", "платформа подрядчика; UI оператора")
System(pcc, "Система партнёрского кол-центра", "внешняя система; API-интеграции невозможны, только файлы")
System(sftp, "SFTP-сервер банка", "новый: файловый обмен с партнёром")

Rel(depBack, abs, "Изменение ставок (десктоп-клиент)")
Rel(abs, dis, "REST: синхронизация справочника ставок")
Rel(dis, cc, "REST API ставок: актуальные ставки для операторов")
Rel(dis, sftp, "Выкладка файла со ставками при изменении и по расписанию")
Rel(sftp, pcc, "Загрузка файла со ставками (SFTP, только чтение)")
Rel(ccOperator, cc, "Просмотр ставок в интерфейсе")
Rel(pccOperator, pcc, "Просмотр ставок в интерфейсе")
Rel(itAdmin, sftp, "Администрирование, доступы, мониторинг")

SHOW_LEGEND()
@enduml
