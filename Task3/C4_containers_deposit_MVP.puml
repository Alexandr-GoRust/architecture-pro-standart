@startuml C4_Containers_Deposit_MVP
!include <C4/C4_Container>

title C4 L2. Контейнеры — MVP онлайн-депозиты (детализация интернет-банка и АБС)

Person(client, "Клиент банка")
Person(depBack, "Менеджер бэк-офиса депозитов")
Person(credBack, "Менеджер бэк-офиса кредитов")
Person(ccOperator, "Оператор кол-центра")

System_Boundary(ib, "Интернет-банк") {
  Container(ibDepUi, "Модуль депозитов (UI)", "ASP.NET MVC 4.5, доработка команды банка", "Каталог депозитов с актуальными и персональными ставками, форма заявки, ввод СМС-кода, статус заявки")
  Container(ibCore, "Ядро монолита интернет-банка", "ASP.NET MVC 4.5 (.NET 4.5), платформа подрядчика", "Платежи и текущие счета — без изменений, доработки ядра нет")
  ContainerDb(ibDb, "БД интернет-банка", "MS SQL", "Данные платформы подрядчика")
}

System_Boundary(dis, "Сервис интеграции депозитов (новый)") {
  Container(disApi, "API сервиса интеграции депозитов", "Java Spring Boot", "REST: ставки, заявки, СМС-коды, лиды; кэш ставок с TTL; ограничение частоты обращений к АБС")
  ContainerDb(disDb, "БД сервиса интеграции", "Oracle, отдельная схема", "Кэш ставок, заявки, СМС-коды, лиды с сайта")
}

System_Boundary(abs, "АБС") {
  Container(absApi, "API депозитов АБС (новый)", "REST-интерфейс над ядром АБС", "Выдача ставок, приём заявок из ДИС, возврат статусов")
  Container(absRates, "Справочник ставок + аудит (новый модуль)", "PL/SQL", "Единый источник истины по ставкам вместо Excel; ведут оба бэк-офиса с разграничением доступа")
  Container(absCore, "Ядро АБС", "Delphi-клиент + PL/SQL", "Счета, договоры, заявки, обработка бэк-офисом по существующему процессу")
  ContainerDb(absDb, "БД АБС", "Oracle", "Перегружена; масштабирование только вертикальное")
}

System(site, "Сайт банка", "PHP + React")
System(cc, "Система кол-центра", "Java Spring Boot + PostgreSQL, платформа подрядчика")
System(smsgw, "СМС-шлюз телеком-оператора")

Rel(client, ibDepUi, "Просмотр депозитов, подача заявки, ввод СМС-кода")
Rel(client, ibCore, "Платежи, текущие счета (существующий функционал)")
Rel(ibCore, ibDb, "SQL")
Rel(client, site, "Заявка на депозит (лид)")
Rel(ibDepUi, disApi, "REST/TLS: ставки, заявки, СМС-коды, статусы")
Rel(site, disApi, "REST/TLS: публичные ставки, лид")
Rel(disApi, disDb, "SQL")
Rel(disApi, absApi, "REST/TLS: синхронизация справочника ставок, передача заявок, получение статусов")
Rel(absApi, absRates, "Чтение/запись ставок")
Rel(absApi, absCore, "Создание заявок, запрос статусов")
Rel(absRates, absDb, "SQL")
Rel(absCore, absDb, "SQL")
Rel(depBack, absCore, "Десктоп-клиент АБС: обработка заявок, ставки")
Rel(credBack, absCore, "Десктоп-клиент АБС: кредитный риск для ставок")
Rel(disApi, cc, "REST/TLS: лиды с сайта")
Rel(ccOperator, cc, "Работа с обращениями")
Rel(disApi, smsgw, "СМС-коды, уведомления о подтверждении ставки и открытии депозита")
Rel(smsgw, client, "СМС")

SHOW_LEGEND()
@enduml
