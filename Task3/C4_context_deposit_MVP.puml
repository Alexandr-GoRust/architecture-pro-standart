@startuml C4_Context_Deposit_MVP
!include <C4/C4_Context>

title C4 L1. Контекст системы — MVP онлайн-депозиты банка «Стандарт»

Person(client, "Клиент банка", "держатель текущих счетов")
Person(depBack, "Менеджер бэк-офиса депозитов", "обрабатывает заявки, согласует ставки")
Person(credBack, "Менеджер бэк-офиса кредитов", "ведёт уровень кредитного риска для ставок")
Person(ccOperator, "Оператор кол-центра", "консультирует и обрабатывает лиды с сайта")

System(ib, "Интернет-банк", "платежи и текущие счета; в MVP — каталог депозитов и подача заявки")
System(site, "Сайт банка", "PHP + React; витрина и заявка на депозит для новых клиентов")
System(dis, "Сервис интеграции депозитов", "НОВЫЙ: ставки, заявки, СМС-коды, лиды; экранирует АБС от онлайн-нагрузки")
System(abs, "АБС", "ядро: счета, договоры, справочник ставок (новый), обработка заявок бэк-офисом")
System(cc, "Система кол-центра", "платформа подрядчика, React + Java Spring Boot + PostgreSQL")
System(smsgw, "СМС-шлюз телеком-оператора", "отправка СМС-кодов и уведомлений")

Rel(client, ib, "Просмотр депозитов, подача заявки, подтверждение СМС-кодом")
Rel(client, site, "Заявка на депозит (телефон, Ф. И. О.)")
Rel(ib, dis, "REST/TLS: ставки, заявки, статусы, СМС-коды")
Rel(site, dis, "REST/TLS: публичные ставки, лиды")
Rel(dis, abs, "REST API депозитов (новый): синхронизация ставок, передача заявок, статусы")
Rel(dis, cc, "REST: передача лидов с сайта в обращения")
Rel(dis, smsgw, "СМС-код подтверждения, уведомления о ставке и открытии")
Rel(smsgw, client, "СМС")
Rel(ccOperator, cc, "Работа с обращениями")
Rel(depBack, abs, "Десктоп-клиент АБС: обработка заявок, ведение ставок")
Rel(credBack, abs, "Десктоп-клиент АБС: уровень кредитного риска для расчёта ставок")

SHOW_LEGEND()
@enduml
